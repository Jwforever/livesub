<Window x:Class="LiveSub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LiveSub"
        Title="LiveSub"
        Width="1000" Height="740"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/livesub.ico"
        Foreground="{StaticResource Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource PageBg}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="HistoryTemplate">
            <Border Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#617181" Margin="0,4,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding English}" FontSize="14" Foreground="#A9BED1" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Chinese}" FontSize="20" Foreground="#F4F8FF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:TitleBar Grid.Row="0" Title="LiveSub"/>
        <Grid Grid.Row="1" Margin="26,12,26,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="实时字幕翻译" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LanguageHintText" Text="系统声音 · 英语 → 中文" FontSize="12" Foreground="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="查看日志" Style="{StaticResource RowButton}" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenLogButton" Click="OpenLog_Click"/>
                    <Button x:Name="ModelBadgeButton" Style="{StaticResource SecondaryButton}" Padding="12,6" AutomationProperties.AutomationId="ModelBadgeButton" Click="ModelBadge_Click" ToolTip="管理本地模型">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ModelDot" Width="7" Height="7" Fill="#FF30D158" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelBadgeText" FontSize="11" Foreground="{StaticResource Primary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="›" FontSize="14" Foreground="{StaticResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="16,12" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="系统声音" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="DeviceCombo" Height="34" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectionChanged="DeviceCombo_SelectionChanged"/>
                        <Button Grid.Column="2" x:Name="RefreshDevicesButton" Content="刷新设备" Style="{StaticResource RowButton}" Margin="10,0,0,0" AutomationProperties.AutomationId="RefreshDevicesButton" Click="RefreshDevices_Click"/>
                        <Button Grid.Column="3" x:Name="StartButton" Content="开始翻译" Margin="10,0,0,0" Padding="22,7" FontSize="14" AutomationProperties.AutomationId="StartButton" Click="StartButton_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="识别引擎" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource Secondary}"/>
                            <ComboBox x:Name="EngineCombo" Width="150" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="6,0,10,0" SelectionChanged="EngineCombo_SelectionChanged" AutomationProperties.AutomationId="EngineCombo"/>
                            <TextBlock Text="原文语言" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource Secondary}"/>
                            <ComboBox x:Name="SourceLanguageCombo" Width="82" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="6,0,0,0" SelectionChanged="SourceLanguageCombo_SelectionChanged" AutomationProperties.AutomationId="SourceLanguageCombo"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="AudioStatusText" Text="输出设备：系统默认（推荐，跟随当前播放设备）" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="识别方式说明"/>
                        <Button Grid.Column="2" x:Name="SystemCaptionsButton" Content="显示系统字幕" Style="{StaticResource RowButton}" Padding="8,3" Margin="12,0,0,0" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="SystemCaptionsButton" Click="SystemCaptionsButton_Click"/>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,4">
                            <TextBlock Text="字幕背景透明度" Width="96" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider" Width="120" Margin="8,0,0,0" Minimum="0" Maximum="100" Value="86" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityValue" Text="86%" Width="36" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,4">
                            <TextBlock Text="字幕字体透明度" Width="96" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <Slider x:Name="TextOpacitySlider" Width="120" Margin="8,0,0,0" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="TextOpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="TextOpacityValue" Text="100%" Width="36" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,4">
                            <TextBlock Text="字幕字体大小" Width="96" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <Slider x:Name="FontSizeSlider" Width="120" Margin="8,0,0,0" Minimum="0" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="FontSizeSlider_ValueChanged" AutomationProperties.AutomationId="FontSizeSlider"/>
                            <TextBlock x:Name="FontSizeValue" Text="50%" Width="36" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Grid.Row="3">
                        <Button x:Name="PreviewButton" Content="预览效果" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,8,0" AutomationProperties.AutomationId="PreviewButton" Click="PreviewButton_Click"/>
                        <Button x:Name="MoveButton" Content="调整位置" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,8,0" Click="MoveButton_Click"/>
                        <Button x:Name="ResetButton" Content="重置位置" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,8,0" Click="ResetButton_Click"/>
                        <Button x:Name="LanguageButton" Content="关闭原文" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,8,0" AutomationProperties.AutomationId="LanguageButton" Click="LanguageButton_Click"/>
                        <Button x:Name="OverlayToggleButton" Content="隐藏字幕" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,8,0" AutomationProperties.AutomationId="OverlayToggleButton" Click="OverlayToggleButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="20,14,20,12" CornerRadius="20" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" x:Name="HistoryCount" Text="0 条" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="清空记录" Style="{StaticResource RowButton}" Margin="8,0,0,0" Click="ClearHistory_Click"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" x:Name="LevelBar" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryTemplate}"/>
                        </ScrollViewer>
                        <TextBlock x:Name="HistoryEmpty"
                                   Text="开始翻译后，字幕将按时间顺序显示在这里"
                                   FontSize="12"
                                   Foreground="#617181"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
