<Window x:Class="LiveSub.AddModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LiveSub"
        Title="LiveSub 添加模型"
        Width="480" Height="470"
        MinWidth="440" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="Assets/livesub.ico"
        Foreground="{StaticResource Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource PageBg}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:TitleBar Grid.Row="0" Title="LiveSub · 添加自定义模型"/>
        <Grid Grid.Row="1" Margin="24,14,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="粘贴模型的直接下载链接（resolve 直链），支持 Hugging Face 与 hf-mirror。" FontSize="11" Foreground="{StaticResource Secondary}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="名称" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,12,0,5"/>
            <TextBox Grid.Row="2" x:Name="NameBox" Height="32" AutomationProperties.AutomationId="AddModelName"/>
            <TextBlock Grid.Row="3" Text="类型" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,10,0,5"/>
            <ComboBox Grid.Row="4" x:Name="KindCombo" Height="32" VerticalContentAlignment="Center" AutomationProperties.AutomationId="AddModelKind">
                <ComboBoxItem Content="语音识别（Whisper ggml）" IsSelected="True"/>
                <ComboBoxItem Content="中文翻译（GGUF 大模型）"/>
            </ComboBox>
            <TextBlock Grid.Row="5" Text="下载地址" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,10,0,5"/>
            <TextBox Grid.Row="6" x:Name="UrlBox" Height="32" AutomationProperties.AutomationId="AddModelUrl"/>
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="文件名（可选）" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FileNameBox" Width="170" Height="30" FontSize="11" AutomationProperties.AutomationId="AddModelFile"/>
                <TextBlock Text="大小 MB（可选）" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="SizeBox" Width="100" Height="30" FontSize="11" AutomationProperties.AutomationId="AddModelSize"/>
            </StackPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="添加" Click="Add_Click" Padding="18,7" AutomationProperties.AutomationId="AddModelConfirm"/>
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
